# name: test/sql/api_every_function.test
# description: every spec-driven function returns rows from the replay server (generated by test/fixtures/build_api_tests.py)
# group: [stripe]

require vgi

require-env STRIPE_WORKER

require-env STRIPE_FIXTURE_URL

statement ok
LOAD json;

statement ok
ATTACH 'stripe' (TYPE vgi, LOCATION '{STRIPE_WORKER}');

statement ok
CREATE SECRET stripe_fixture (TYPE stripe, API_KEY 'sk_test_fixture', BASE_URL '{STRIPE_FIXTURE_URL}');

