SUMMER25	25.0	NULL	true
WELCOME10	NULL	10.000	true

query TTT
SELECT code, coupon, minimum_amount_decimal::VARCHAR FROM stripe.main.promotion_codes() WHERE active ORDER BY code;
----
SUMMER25	SUMMER25	NULL
WELCOME	WELCOME10	20.000

query TTT
SELECT id, percentage::VARCHAR, inclusive FROM stripe.main.tax_rates() WHERE active ORDER BY id;
