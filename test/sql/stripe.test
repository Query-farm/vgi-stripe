query TI
SELECT type, count(*) FROM stripe.main.events() WHERE starts_with(type, 'invoice.') GROUP BY type ORDER BY type;
----
invoice.created	1
invoice.finalized	2
invoice.marked_uncollectible	1
invoice.paid	1
invoice.voided	1

query TTTT
SELECT type, object_type, object_id, previous_attributes FROM stripe.main.events() WHERE type = 'customer.subscription.updated';
----
customer.subscription.updated	subscription	sub_margaret	{"cancel_at_period_end":false}

query I
SELECT count(*) FROM stripe.main.events();
----
38

query T
SELECT id FROM stripe.main.events() WHERE object_id = 'ch_6' ORDER BY id;
----
evt_ch_6
evt_re_2

query TTT
SELECT id, url_host, status FROM stripe.main.webhook_endpoints() ORDER BY id;
----
we_1	hooks.example.com	enabled
we_2	audit.example.org	disabled

# Neither the signing secret nor the URL path/query (which carry tokens) appear anywhere.
query I
SELECT count(*) FROM stripe.main.webhook_endpoints() WHERE raw::VARCHAR LIKE '%whsec%' OR raw::VARCHAR LIKE '%hunter2%' OR raw::VARCHAR LIKE '%/stripe/webhook%';
----
0

# The first /v1/files call answers 503 with Stripe-Should-Retry: false, which is not retried.
statement error
SELECT count(*) FROM stripe.main.files();
----
<REGEX>:.*HTTP 503.*

query TTI
SELECT id, purpose, size FROM stripe.main.files() ORDER BY id;
----
file_1	dispute_evidence	48213
file_2	finance_report_run	1024
file_3	identity_document	512000
